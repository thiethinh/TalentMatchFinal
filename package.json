{
  "name": "talentmatch-platform",
  "version": "1.0.0",
  "description": "TalentMatch - Nền tảng kết nối việc làm Freelancer và Khách hàng",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "node scripts/setup.js",
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "dev:docker": "docker compose up --build",
    "dev:d": "docker compose up -d --build",
    "dev:down": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:local": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend:run\" \"npm run frontend:dev\"",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose stop mysql",
    "db:logs": "docker compose logs -f mysql",
    "backend:run": "node scripts/gradle.js bootRun",
    "backend:build": "node scripts/gradle.js build",
    "backend:test": "node scripts/gradle.js test",
    "backend:clean": "node scripts/gradle.js clean",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "frontend:lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
